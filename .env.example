# Copy this file to .env.local and fill in the values from your deployed AWS stack.
# .env.local is gitignored. `bash scripts/deploy.sh` writes these values automatically.

# WebSocket API endpoint (used by src/hooks/useSession.js)
VITE_WS_URL=wss://<api-id>.execute-api.<region>.amazonaws.com/prod

# HTTP API endpoint (used by src/components/Lobby.jsx)
VITE_API_URL=https://<http-api-id>.execute-api.<region>.amazonaws.com
